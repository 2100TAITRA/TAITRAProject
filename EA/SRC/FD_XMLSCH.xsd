<?xml version="1.0" standalone="yes" ?>
<xsd:schema id="ROWSET" xmlns="" xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:msdata="urn:schemas-microsoft-com:xml-msdata">
	<xsd:element name="ROWSET" msdata:IsDataSet="true" msdata:Locale="zh-TW">
		<xsd:complexType>
			<xsd:choice maxOccurs="unbounded">
				<xsd:element name="ROW">
					<xsd:complexType>
						<xsd:sequence>
							<xsd:element name="檔案目錄傳送名稱" type="xsd:string" minOccurs="0" msdata:Ordinal="0" />
							<xsd:element name="功能" type="xsd:string" minOccurs="0" msdata:Ordinal="1" />
							<xsd:element name="案由" type="xsd:string" minOccurs="0" msdata:Ordinal="2" nillable="true" />
							<xsd:element name="並列案由" type="xsd:string" minOccurs="0" msdata:Ordinal="3" nillable="true" default="並列案由預設值" />
							<xsd:element name="其他案由" type="xsd:string" minOccurs="0" msdata:Ordinal="4" nillable="true" />
							<xsd:element name="案名" type="xsd:string" minOccurs="0" msdata:Ordinal="5" nillable="true" />
							<xsd:element name="相關案件" type="xsd:string" minOccurs="0" msdata:Ordinal="6" nillable="true" />
							<xsd:element name="主要發文者" type="xsd:string" minOccurs="0" msdata:Ordinal="7" />
							<xsd:element name="主要來文者" type="xsd:string" minOccurs="0" msdata:Ordinal="8" />
							<xsd:element name="次要發文者" type="xsd:string" minOccurs="0" msdata:Ordinal="9" />
							<xsd:element name="次要來文者" type="xsd:string" minOccurs="0" msdata:Ordinal="10" />
							<xsd:element name="發文者之補正" type="xsd:string" minOccurs="0" msdata:Ordinal="11" />
							<xsd:element name="來文者之補正" type="xsd:string" minOccurs="0" msdata:Ordinal="12" />
							<xsd:element name="文別" type="xsd:string" minOccurs="0" msdata:Ordinal="13" />
							<xsd:element name="本別" type="xsd:string" minOccurs="0" msdata:Ordinal="14" />
							<xsd:element name="密等" type="xsd:string" minOccurs="0" msdata:Ordinal="15" />
							<xsd:element name="解密條件" type="xsd:string" minOccurs="0" msdata:Ordinal="16" />
							<xsd:element name="保存年限" type="xsd:string" minOccurs="0" msdata:Ordinal="17" />
							<xsd:element name="應用限制" type="xsd:string" minOccurs="0" msdata:Ordinal="18" />
							<xsd:element name="保存狀況" type="xsd:string" minOccurs="0" msdata:Ordinal="19" />
							<xsd:element name="調整後之保存年限" type="xsd:string" minOccurs="0" msdata:Ordinal="20" />
							<xsd:element name="保存年限調整原因" type="xsd:string" minOccurs="0" msdata:Ordinal="21" />
							<xsd:element name="核准銷毀文號" type="xsd:string" minOccurs="0" msdata:Ordinal="22" />
							<xsd:element name="銷毀日期" type="xsd:string" minOccurs="0" msdata:Ordinal="23" />
							<xsd:element name="解密日期" type="xsd:string" minOccurs="0" msdata:Ordinal="24" />
							<xsd:element name="移轉註記" type="xsd:string" minOccurs="0" msdata:Ordinal="25" />
							<xsd:element name="延長移轉屆滿日期" type="xsd:string" minOccurs="0" msdata:Ordinal="26" />
							<xsd:element name="移轉日期" type="xsd:string" minOccurs="0" msdata:Ordinal="27" />
