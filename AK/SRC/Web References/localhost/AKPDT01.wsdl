          <s:element minOccurs="0" maxOccurs="1" name="辦畢日期" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="發文日期" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="收文日期" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="來文日期" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="媒體型式" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="數量" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="計量單位" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="檔案種類" type="s:string" />
          <s:element minOccurs="0" maxOccurs="unbounded" name="附件" type="s1:DocAtt" />
          <s:element minOccurs="0" maxOccurs="unbounded" name="主題" type="s1:DocTheme" />
          <s:element minOccurs="0" maxOccurs="unbounded" name="附註" type="s1:DocRemark" />
          <s:element minOccurs="0" maxOccurs="1" name="承辦" type="s1:DocRps" />
          <s:element minOccurs="0" maxOccurs="unbounded" name="會辦" type="s1:DocConf" />
          <s:element minOccurs="0" maxOccurs="unbounded" name="受文者" type="s1:Reveiver" />
        </s:sequence>
        <s:attribute name="num" type="s:string" />
      </s:complexType>
      <s:complexType name="DocAtt">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="附件名稱" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="附件媒體型式" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="附件數量" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="附件單位" type="s:string" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="DocTheme">
        <s:simpleContent>
          <s:extension base="s:string">
            <s:attribute name="num" type="s:string" />
          </s:extension>
        </s:simpleContent>
      </s:complexType>
      <s:complexType name="DocRemark">
        <s:simpleContent>
          <s:extension base="s:string">
            <s:attribute name="num" type="s:string" />
          </s:extension>
        </s:simpleContent>
      </s:complexType>
      <s:complexType name="DocRps">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="承辦單位代碼" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="承辦單位" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="承辦人" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="承辦人代碼" type="s:string" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="DocConf">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="會辦單位代碼" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="會辦單位" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="會辦人" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="會辦人代碼" type="s:string" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="Reveiver">
        <s:simpleContent>
          <s:extension base="s:string" />
        </s:simpleContent>
      </s:complexType>
      <s:element name="歸檔紀錄集合" type="s1:RtnRecordSet" />
      <s:complexType name="RtnRecordSet">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="unbounded" name="歸檔紀錄" type="s1:RtnRecord" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="RtnRecord">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="收文字號" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="歸檔單位代碼" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="歸檔單位" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="歸檔日期" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="歸檔時間" type="s:string" />
        </s:sequence>
      </s:complexType>
    </s:schema>
  </types>
  <message name="ImportSoapIn">
    <part name="parameters" element="s0:Import" />
  </message>
  <message name="ImportSoapOut">
    <part name="parameters" element="s0:ImportResponse" />
  </message>
  <message name="ImportByArgSoapIn">
    <part name="parameters" element="s0:ImportByArg" />
  </message>
  <message name="ImportByArgSoapOut">
    <part name="parameters" element="s0:ImportByArgResponse" />
  </message>
  <message name="ExportSoapIn">
    <part name="parameters" element="s0:Export" />
  </message>
  <message name="ExportSoapOut">
    <part name="parameters" element="s0:ExportResponse" />
  </message>
  <message name="ImportHttpGetIn">
    <part name="argORG_NO" type="s:string" />
  </message>
  <message name="ImportHttpGetOut">
    <part name="Body" element="s0:string" />
  </message>
  <message name="ExportHttpGetIn">
    <part name="argOrgNo" type="s:string" />
  </message>
  <message name="ExportHttpGetOut">
    <part name="Body" element="s0:string" />
  </message>
  <message name="ImportHttpPostIn">
    <part name="argORG_NO" type="s:string" />
  </message>
  <message name="ImportHttpPostOut">
    <part name="Body" element="s0:string" />
  </message>
  <message name="ExportHttpPostIn">
    <part name="argOrgNo" type="s:string" />
  </message>
  <message name="ExportHttpPostOut">
    <part name="Body" element="s0:string" />
  </message>
  <portType name="AKPDT01Soap">
    <operation name="Import">
      <input message="s0:ImportSoapIn" />
      <output message="s0:ImportSoapOut" />
    </operation>
    <operation name="ImportByArg">
      <input message="s0:ImportByArgSoapIn" />
      <output message="s0:ImportByArgSoapOut" />
    </operation>
    <operation name="Export">
      <input message="s0:ExportSoapIn" />
      <output message="s0:ExportSoapOut" />
    </operation>
  </portType>
  <portType name="AKPDT01HttpGet">
    <operation name="Import">
      <input message="s0:ImportHttpGetIn" />
      <output message="s0:ImportHttpGetOut" />
    </operation>
    <operation name="Export">
      <input message="s0:ExportHttpGetIn" />
      <output message="s0:ExportHttpGetOut" />
    </operation>
  </portType>
  <portType name="AKPDT01HttpPost">
