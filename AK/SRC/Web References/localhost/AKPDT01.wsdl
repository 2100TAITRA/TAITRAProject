      <input>
        <soap:body use="literal" />
      </input>
      <output>
        <soap:body use="literal" />
      </output>
    </operation>
    <operation name="Export">
      <soap:operation soapAction="http://www.2100.com.tw/webservices/Export" style="document" />
      <input>
        <soap:body use="literal" />
      </input>
      <output>
        <soap:body use="literal" />
      </output>
    </operation>
  </binding>
  <binding name="AKPDT01HttpGet" type="s0:AKPDT01HttpGet">
    <http:binding verb="GET" />
    <operation name="Import">
      <http:operation location="/Import" />
      <input>
        <http:urlEncoded />
      </input>
      <output>
        <mime:mimeXml part="Body" />
      </output>
    </operation>
    <operation name="Export">
      <http:operation location="/Export" />
      <input>
        <http:urlEncoded />
      </input>
      <output>
        <mime:mimeXml part="Body" />
      </output>
    </operation>
  </binding>
