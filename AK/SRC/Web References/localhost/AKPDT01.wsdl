    <http:binding verb="POST" />
    <operation name="Import">
      <http:operation location="/Import" />
      <input>
        <mime:content type="application/x-www-form-urlencoded" />
      </input>
      <output>
        <mime:mimeXml part="Body" />
      </output>
    </operation>
    <operation name="Export">
      <http:operation location="/Export" />
      <input>
        <mime:content type="application/x-www-form-urlencoded" />
      </input>
      <output>
        <mime:mimeXml part="Body" />
      </output>
    </operation>
  </binding>
  <service name="AKPDT01">
    <documentation>結辦公文資料轉入作業</documentation>
    <port name="AKPDT01Soap" binding="s0:AKPDT01Soap">
      <soap:address location="http://localhost/AK/AKPDT01.asmx" />
