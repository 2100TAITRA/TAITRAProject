<?xml version="1.0" encoding="utf-8"?>
<definitions xmlns:s1="http://www.cpandl.com" xmlns:http="http://schemas.xmlsoap.org/wsdl/http/" xmlns:soap="http://schemas.xmlsoap.org/wsdl/soap/" xmlns:s="http://www.w3.org/2001/XMLSchema" xmlns:s0="http://www.2100.com.tw/webservices/" xmlns:soapenc="http://schemas.xmlsoap.org/soap/encoding/" xmlns:tm="http://microsoft.com/wsdl/mime/textMatching/" xmlns:mime="http://schemas.xmlsoap.org/wsdl/mime/" targetNamespace="http://www.2100.com.tw/webservices/" xmlns="http://schemas.xmlsoap.org/wsdl/">
  <types>
    <s:schema elementFormDefault="qualified" targetNamespace="http://www.2100.com.tw/webservices/">
      <s:import namespace="http://www.cpandl.com" />
      <s:element name="Import">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="argORG_NO" type="s:string" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="ImportResponse">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="ImportResult" type="s:string" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="ImportByArg">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="argOrgNo" type="s:string" />
            <s:element minOccurs="0" maxOccurs="1" ref="s1:詮釋資料集合" />
            <s:element minOccurs="0" maxOccurs="1" ref="s1:歸檔紀錄集合" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="ImportByArgResponse">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="ImportByArgResult" type="s:string" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="Export">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="argOrgNo" type="s:string" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="ExportResponse">
        <s:complexType>
          <s:sequence>
            <s:element minOccurs="0" maxOccurs="1" name="ExportResult" type="s:string" />
          </s:sequence>
        </s:complexType>
      </s:element>
      <s:element name="string" nillable="true" type="s:string" />
    </s:schema>
    <s:schema elementFormDefault="qualified" targetNamespace="http://www.cpandl.com">
      <s:element name="詮釋資料集合" type="s1:DocDescSet" />
      <s:complexType name="DocDescSet">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="unbounded" name="詮釋資料" type="s1:DocDesc" />
        </s:sequence>
      </s:complexType>
      <s:complexType name="DocDesc">
        <s:sequence>
          <s:element minOccurs="0" maxOccurs="1" name="案由" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="並列案由" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="其他案由" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="案名" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="相關案件" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="主要發文者" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="主要來文者" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="次要發文者" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="次要來文者" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="發文者之補正" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="來文者之補正" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="文別" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="本別" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="密等" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="保密期限" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="解密條件" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="保存年限" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="應用限制" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="發文字號" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="收文字號" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="彙併辦主文號" type="s:string" />
