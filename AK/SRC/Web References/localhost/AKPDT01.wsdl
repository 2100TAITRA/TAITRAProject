          <s:element minOccurs="0" maxOccurs="1" name="分類號" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="案次號" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="卷次號" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="目次號" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="電子檔案路徑" type="s:string" />
          <s:element minOccurs="0" maxOccurs="1" name="電子檔案封裝檔名稱" type="s:string" />
