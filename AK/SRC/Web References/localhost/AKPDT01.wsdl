    </operation>
    <operation name="Export">
      <input message="s0:ExportHttpPostIn" />
      <output message="s0:ExportHttpPostOut" />
    </operation>
  </portType>
  <binding name="AKPDT01Soap" type="s0:AKPDT01Soap">
    <soap:binding transport="http://schemas.xmlsoap.org/soap/http" style="document" />
    <operation name="Import">
      <soap:operation soapAction="http://www.2100.com.tw/webservices/Import" style="document" />
      <input>
        <soap:body use="literal" />
