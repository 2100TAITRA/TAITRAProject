      <soap:operation soapAction="http://tempuri.org/Decryptor" style="document" />
      <input>
        <soap:body use="literal" />
      </input>
      <output>
        <soap:body use="literal" />
      </output>
    </operation>
  </binding>
  <service name="Crypto">
    <port name="CryptoSoap" binding="s0:CryptoSoap">
      <soap:address location="http://localhost/WebApplication1/Crypto.asmx" />
