<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<sectionGroup name="applicationSettings" type="System.Configuration.ApplicationSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089">
			<section name="OM2.Properties.Settings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
		</sectionGroup>
	</configSections>
	<!--
    如需 web.config 變更的說明，請參閱 http://go.microsoft.com/fwlink/?LinkId=235367。

    您可以在 <httpRuntime> 標紀上設定下列屬性。
      <system.Web>
        <httpRuntime targetFramework="4.5" />
      </system.Web>
  -->
	<system.webServer>
		<handlers>
			<add name="CrystalImageHandler.aspx_GET" verb="GET" path="CrystalImageHandler.aspx" type="CrystalDecisions.Web.CrystalImageHandler, CrystalDecisions.Web, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" preCondition="integratedMode" />
		</handlers>
		<validation validateIntegratedModeConfiguration="false" />
		<httpProtocol>
			<customHeaders>
				<remove name="Content-Security-Policy" />
				<remove name="X-Powered-By" />
				<remove name="Access-Control-Allow-Credentials" />
				<remove name="Access-Control-Allow-Origin" />
				<remove name="Access-Control-Allow-Methods" />
				<remove name="Access-Control-Allow-Headers" />
				<add name="Access-Control-Allow-Headers" value="SOAPAction,Content-Type,Cache-Control,Accept" />
				<add name="Access-Control-Allow-Methods" value="POST,GET,OPTIONS" />
				<add name="Access-Control-Allow-Origin" value="*" />
				<add name="Access-Control-Allow-Credentials" value="true" />
				<add name="Content-Security-Policy" value="default-src 'self'; connect-src 'self' blob: http://localhost:61161 http://localhost:21001 http://localhost:16888 http://localhost:56445 ws://localhost:21001 https://localhost:56445 https://localhost:56545 https://localhost:56645 *.fdat.com.tw; frame-ancestors CertMgmt: http://localhost:61161 http://localhost:21001 http://localhost:16888 http://localhost:56445 ws://localhost:21001 https://localhost:56445 https://localhost:56545 https://localhost:56645 *.fdat.com.tw; frame-src CertMgmt: http://localhost:61161 http://localhost:21001 http://localhost:16888 http://localhost:56445 ws://localhost:21001 https://localhost:56445 https://localhost:56545 https://localhost:56645 *.fdat.com.tw; img-src 'self' data: http://localhost:61161 http://localhost:21001 http://localhost:16888 http://localhost:56445 ws://localhost:21001 https://localhost:56445 https://localhost:56545 https://localhost:56645 *.fdat.com.tw; form-action 'self'; font-src 'self'; media-src 'self'; manifest-src 'self'; object-src 'self'; worker-src 'self';script-src 'self' 'unsafe-inline' 'unsafe-eval'; script-src-attr 'self' 'unsafe-inline' 'unsafe-eval'; script-src-elem 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src-attr 'self' 'unsafe-inline' 'unsafe-eval'; style-src-elem 'self' 'unsafe-inline' 'unsafe-eval';" />
			</customHeaders>
		</httpProtocol>
	</system.webServer>
	<system.web>
		<httpHandlers>
			<add verb="POST,GET" path="ajaxpro/*.ashx" type="AjaxPro.AjaxHandlerFactory, AjaxPro.2" />
			<add verb="GET" path="CrystalImageHandler.aspx" type="CrystalDecisions.Web.CrystalImageHandler, CrystalDecisions.Web, Version=13.0.4000.0, Culture=neutral, PublicKeyToken=692fbea5521e1304" />
		</httpHandlers>
		<webServices>
			<soapExtensionTypes>
				<add type="Microsoft.Web.Services.WebServicesExtension,Microsoft.Web.Services, Version=1.0.0.0,Culture=neutral,PublicKeyToken=31bf3856ad364e35" priority="1" group="High" />
			</soapExtensionTypes>
			<protocols>
				<!--<remove name="Documentation" />-->
			</protocols>
		</webServices>
		<httpRuntime enableVersionHeader="false" executionTimeout="3600" maxRequestLength="1024000" />
		<!--  動態偵錯編譯
      設定 compilation debug="true" 以啟用 ASPX 偵錯。否則，將這個值設定為
      false 將可增進這個應用程式的 Runtime 效能。 
      設定 compilation debug="true" 以將偵錯符號 (.pdb 資訊) 插入到編譯過的網頁。因為這樣將會建立較大的檔案並使執行速度變慢，
      因此您應該只在偵錯時將這個值設為 true，其他時間都設為 false。
      如需詳細資訊，請參閱偵錯 ASP.NET 檔案相關的文件。
    -->
		<identity impersonate="false" />
		<compilation debug="true" defaultLanguage="c#" targetFramework="4.8" />
		<!--  自訂錯誤訊息
      設定 customError mode 的值以控制顯示使用者易讀的錯誤訊息而不是錯誤的 
      詳細資訊 (包含堆疊追蹤):
      "On" 永遠顯示自訂 (易讀) 訊息 
      "Off" 永遠顯示詳細的 ASP.NET 錯誤資訊。
      "RemoteOnly" 僅顯示自訂 (易讀) 訊息給不在區域 Web 伺服器上的使用者。針對安全
      性目的，建議您使用這項設定，這樣子您就不會將應用程式的詳細資訊顯示給遠端用戶端。
    -->
		<customErrors mode="Off" />
		<!--  驗證 
      這個區段將設定應用程式的驗證原則。可能的模式包括 "Windows"、"Forms"、
      "Passport" 和 "None"
    -->
		<authentication mode="None" />
		<!--  應用程式層級追蹤紀錄
      應用程式層級追蹤啟用應用程式中每一頁面的追蹤紀錄檔輸出。
      設定 trace enabled="true" 將啟用應用程式追蹤紀錄。如果 pageOutput="true"，追蹤資訊將顯示
      在每一頁面的下方。此外，您也可以從 Web 應用程式的根目錄透過瀏覽 "trace.axd" 頁面的方式來檢視
      應用程式的追蹤紀錄檔。
    -->
		<trace enabled="true" requestLimit="10" pageOutput="false" traceMode="SortByTime" localOnly="false" />
		<!--  工作階段狀態設定
      根據預設，ASP.NET 會使用 Cookie 來識別哪些要求是屬於某個特定工作階段。
      如果無法使用 Cookie，您也可以將工作階段識別項加入到 URL 來追蹤工作階段。
      若要停用 Cookie，請設定 sessionState cookieless="true"。
    -->
		<sessionState cookieless="UseCookies" mode="InProc" sqlConnectionString="data source=127.0.0.1;user id=sa;password=" stateConnectionString="tcpip=127.0.0.1:42424" timeout="14300" />
		<!--  全球化設定
      此區段用來設定應用程式全球化選項。
    -->
		<globalization requestEncoding="utf-8" responseEncoding="utf-8" />
		<xhtmlConformance mode="Legacy" />
		<pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID" enableEventValidation="false" />
		<machineKey validation="AES" />
	</system.web>
	<appSettings>
		<!-- TEMPLATE SETTING START -->
		<add key="DB_TYPE" value="OLE" />
		<!--公文系統DB連線-->
		<add key="ConnString" value="Provider=SQLNCLI11;Password=1qaz@WSX3edc;User ID=odsa;Initial Catalog=OD_TAITRA;Data Source=DOCDBTAI;Connect Timeout=900;" />
		<!--駐外系統DB連線-->
		<add key="OMConnString" value="Provider=SQLNCLI11;Password=1qaz@WSX3edc;User ID=odsa;Initial Catalog=OD_TAITRA;Data Source=DOCDBTAI;Connect Timeout=900;" />
		<!-- 設定TimeOut時間 單位:秒 -->
		<add key="CookieTimeOut" value="1440" />
		<add key="ProjectShareJsFile" value="../OMLIB/OM_LIB.js" />
		<!-- 指定共用Component路徑 單位:秒 -->
		<add key="PlugInSource" value="https://new-doc-intra.taitra.org.tw/STD/COMPONENT/PageRender.api" />
		<!-- 指定Custom Err Page路徑 -->
		<!-- 系統使用機關所在 -->
		<add key="Location" value="公文管理系統" />
		<!-- 接受回報錯誤之Mail Address -->
		<add key="Mail2100t" value="YING@2100t.com.tw" />
		<!-- 客戶之Mail Address -->
		<add key="MailCustomer" value="odsys@taitra.org.tw" />
		<!-- 客戶之Mail Server -->
		<add key="MailServer" value="smtp.taitra.org.tw" />
		<!-- Mail Server 指定的Port -->
		<add key="MailServerPort" value="" />
		<!-- 系統寄件者 Email -->
		<add key="FromMailAddr" value="odsys@taitra.org.tw" />
		<!-- 系統寄件者名稱 -->
		<add key="FromMailName" value="文案系統" />
		<!-- 指定Debug模式 -->
		<add key="Debug" value="true" />
		<!-- 指定Log File位置 -->
		<add key="LogPath" value="C:\Temp\" />
		<!-- END OF TEMPLATE SETTING -->
		<!-- PROJECT SETTING START -->
		<!-- 依專案需求所加之config請加在此-->
		<!--OrgNo:機關代碼-->
		<add key="OrgNo" value="XC03702716" />
		<add key="OrgNickName" value="TAITRA" />
		<!--OrgNo:多機關代碼清單-->
		<add key="OrgNoList" value="XC03702716" />
		<!--Basic,KeepYear,File-->
		<add key="SSOServer" value="new-doc-ap.taitra.org.tw" />
		<add key="WORK_PATH" value="c:\temp" />
		<!-- AccountType=1表示Schema用user, 2表示Schema用gipPerson -->
		<add key="AccountType" value="1" />
		<add key="WRITE_LOG_TYPE" value="IEWDTS" />
		<!-- 新版檔案下載服務，無此參數時，預設值"WebFile.ashx" -->
		<add key="WebFilePath" value="OMLIB/WebFile.ashx" />
		<add key="CustomErrPage" value="/STDN/LIB/CustomErr.aspx" />
		<add key="ALLOWUPLOAD_EXT" value="1:.exe|.vbs|.bat|.dll|.js|.config|.asp|.aspx|.asmx|.asa|.asax|.ashx|.asmx|.aspq|.axd|.ascx|.shtm|.html|.htm" />
		<add key="ALLOW_PATH" value="D:\XC03702716\FILE_PATH\OM\" />
		<add key="AuthCookieWithIP" value="N" />
		<add key="THROUGH_IP" value="::1|127.0.0.1|192.168.2.70|172.20.50.126|172.20.50.127|172.20.50.125" />
		<!--附件總大小上限 單位MB-->
		<add key="FileSizeLimit" value="20" />
		<!--附件白名單第一碼為提醒或阻擋C阻擋、W提醒-->
		<add key="WE_ATTACH_CHECK" value="W|ODT;ODS;ODG;ODP;ODF;TXT;JPG;PNG;TIF;PDF;JPEG;BMP;DOCX;DOC;XLSX;XLS;PPTX;PPT;ZIP;7Z;TIF;TIFF" />
		<add key="BoardSide" value="2" />
		<!--附件白名單-比照公文製作-->
		<add key="WE_ALLOW_GENPAGE_ATTACH_FMT" value="TXT;JPG;PNG;TIF;TIFF;PDF;JPEG;ODT;ODF;ODS;ODP;ODG;ODB;BMP;MSG;XML;CSV;OTS;OTT;OTP;DOC;DOCX;XLS;XLSX;PPT;PPTX;ZIP;7Z;RTF" />
		<!--寄送惡意檔案警告通知信，寄件者信箱-->
		<add key="FromEmail" value="odsys@taitra.org.tw" />
		<!--寄送惡意檔案警告通知信，寄件者名稱-->
		<add key="FromEmailName" value="外貿文案系統" />
		<!--寄送惡意檔案警告通知信，被通知信箱-->
		<add key="ErrNotifyMail" value="YING@2100t.com.tw" />
		<!-- 客戶之Mail Server -->
		<add key="MailServer" value="smtp.taitra.org.tw" />
	</appSettings>
	<runtime>
		<assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
			<dependentAssembly>
				<assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-13.0.1.0" newVersion="13.0.1.0" />
			</dependentAssembly>
			<dependentAssembly>
				<assemblyIdentity name="System.Runtime.CompilerServices.Unsafe" publicKeyToken="b03f5f7f11d50a3a" culture="neutral" />
				<bindingRedirect oldVersion="0.0.0.0-6.0.0.0" newVersion="6.0.0.0" />
			</dependentAssembly>
		</assemblyBinding>
	</runtime>
	<applicationSettings>
		<OM2.Properties.Settings>
			<setting name="OM2_OM_I_OMWS" serializeAs="String">
				<value>https://new-doc-ap.taitra.org.tw/OM_I/OMLIB/OMWS.asmx</value>
			</setting>
		</OM2.Properties.Settings>
	</applicationSettings>
</configuration>