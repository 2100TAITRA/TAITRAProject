<?xml version="1.0" encoding="BIG5"?>
<!--  公文標籤集 (交換用)    交換用標籤.ent    1999.12.1    -->

<!ELEMENT  發文機關		((全銜,機關代碼?)|(單位名,(機關代碼,單位代碼)?))>
<!ELEMENT  填表機關		(全銜,機關代碼?)>
<!ELEMENT  機關			(全銜,機關代碼?)>
<!ELEMENT  單位			(單位名,單位代碼?)>

<!ELEMENT  發文日期		(年月日,時分?)>
